# ---------------------------------------------------------------------------
# Pulsara client environment
#
# Copy to `.env` and fill in every value. Vite inlines these at BUILD time, so
# they must be present when the bundle is produced, not when it is served.
# src/config/env.ts validates the whole set on load and fails loudly rather
# than shipping `undefined` into a production bundle.
#
# Everything here is embedded in JavaScript delivered to the browser, so
# nothing in this file may be a secret. The API enforces authorisation; the
# client only ever holds public identifiers.
# ---------------------------------------------------------------------------

# Absolute origin of the Pulsara API. Used for both REST and the WebSocket
# handshake, which must share an origin for credentialed CORS to work.
VITE_API_URL=http://localhost:4000

# --- Google sign-in (optional) ---------------------------------------------
#
# Supply the whole block to enable the "Sign in with Google" button, or omit it
# entirely and the button is not rendered. Values come from the Firebase
# console under Project settings > General > Your apps > SDK setup.
#
# The Firebase web API key is a public project identifier, not a credential:
# it is safe in a client bundle, and access is governed by Firebase Auth rules
# and by this application's own API authorisation.

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
