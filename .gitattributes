# Normalise line endings so a Windows checkout does not produce a whole-file
# diff for every contributor on macOS or Linux, and so shell scripts and the
# Docker build context keep LF regardless of who committed them.
* text=auto eol=lf

# Binary assets must never be transformed.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
