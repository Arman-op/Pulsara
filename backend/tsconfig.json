{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "noEmit": true,
    "sourceMap": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Correctness. `noUncheckedIndexedAccess` in particular turns the common
       `array[i].foo` and `record[key].foo` crashes into compile errors. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  /* Everything TypeScript in the package is type-checked, including the seed
     script and tooling config that the production build deliberately omits. */
  "include": ["src/**/*", "prisma/**/*", "tests/**/*", "prisma.config.ts", "vitest.config.ts"]
}
