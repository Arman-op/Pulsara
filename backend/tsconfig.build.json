{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": false
  },
  /* The production image contains compiled application code only: no seed
     script, no Prisma CLI config, no tests. */
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/test/**/*"]
}
