# ---------------------------------------------------------------------------
# Pulsara API environment
#
# Copy to `.env` and fill in every value. The server validates this file at
# startup (see src/config/env.ts) and refuses to boot on anything missing or
# malformed, so a misconfigured deployment fails immediately and loudly rather
# than at the first request.
#
# Nothing in this file is a real secret. In production these values are
# supplied by AWS Secrets Manager / GitHub Actions secrets and are never
# written to disk.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# One of: development | test | production.
# Controls error verbosity, cookie `secure` flag and log formatting.
NODE_ENV=development

# TCP port the HTTP + WebSocket server binds to.
PORT=4000

# Log verbosity: fatal | error | warn | info | debug | trace.
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------

# PostgreSQL connection string used by Prisma. Must start with `postgres`.
# The local development database is defined in docker-compose.yml.
DATABASE_URL=postgresql://pulsara:pulsara_local_dev@localhost:5433/pulsara?schema=public

# Database the integration tests run against. Optional: the suite falls back to
# a `pulsara_test` database on the same local instance and creates it if it is
# missing. The name must end in `_test`, because the suite truncates every table
# between cases and refuses to do that to a database that is not clearly one.
# TEST_DATABASE_URL=postgresql://pulsara:pulsara_local_dev@localhost:5433/pulsara_test

# --- HTTP ------------------------------------------------------------------

# Comma-separated list of browser origins allowed by CORS and by the
# Socket.IO handshake. No wildcard is accepted: credentials are sent with
# every request, and `Access-Control-Allow-Origin: *` is invalid with them.
CORS_ORIGINS=http://localhost:5174

# Fixed-window rate limit applied to the whole /api surface.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# --- Authentication --------------------------------------------------------

# HMAC signing keys. Minimum 32 characters, and must differ from each other so
# that an access token can never be replayed as a refresh token.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48-output-value
JWT_REFRESH_SECRET=replace-me-with-a-different-openssl-rand-base64-48-value

# Access tokens are short-lived because they are held in browser memory and
# cannot be revoked; the refresh token is the revocable half of the pair.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Credential endpoints (/auth/login, /auth/firebase) get a far tighter budget
# than the rest of the API. Only failed attempts count toward it.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# --- Telemetry -------------------------------------------------------------

# Label applied to every host metric this process records. Defaults to the
# machine's hostname, which is what keeps samples from several replicas
# distinguishable once the API is scaled out.
# TELEMETRY_HOST_ID=

# Host metric collection. Each sample reads real OS counters (CPU, memory,
# disk, network, load).
#
# Sampling and persistence are on separate clocks on purpose. Every sample is
# broadcast to connected clients, exposed on /metrics and evaluated against the
# alert thresholds below; only the mean of each persist window is written to the
# database. Persisting every sample produced roughly a quarter of a million rows
# a day per host to draw a chart that re-buckets them on read anyway.
METRICS_COLLECTION_ENABLED=true
METRICS_SAMPLE_INTERVAL_MS=2000
METRICS_PERSIST_INTERVAL_MS=30000

# Retention. Telemetry is append-only and grows without bound; the sweep runs
# in bounded batches so it never blocks the collector writing the same table.
# Probe results are kept longer because they are the evidence behind uptime
# figures and incident timelines.
METRICS_RETENTION_DAYS=7
PROBE_RESULT_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_MS=3600000

# Host alert thresholds. Usage at or above these, sustained for
# HOST_ALERT_SUSTAINED_SAMPLES consecutive samples, opens a real Incident; usage
# below them for HOST_ALERT_RECOVERY_SAMPLES consecutive samples resolves it
# again. Disk is lower because a full volume is unrecoverable in a way that a
# busy CPU is not. Anything at or above HOST_ALERT_CRITICAL_PERCENT escalates
# the incident to CRITICAL, whichever resource it is.
HOST_ALERTS_ENABLED=true
CPU_ALERT_THRESHOLD_PERCENT=90
MEMORY_ALERT_THRESHOLD_PERCENT=90
DISK_ALERT_THRESHOLD_PERCENT=85
HOST_ALERT_CRITICAL_PERCENT=97
HOST_ALERT_SUSTAINED_SAMPLES=3
HOST_ALERT_RECOVERY_SAMPLES=5

# Prometheus exposition on GET /metrics, outside the API prefix and outside the
# JSON envelope, so any standard scraper can read it.
PROMETHEUS_METRICS_ENABLED=true

# Optional bearer token for /metrics. Leave unset when the port is reachable
# only from inside the cluster network, which is the usual arrangement. Set it
# if the port is exposed: the response names every monitored service, reports
# host saturation and counts open incidents. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# METRICS_SCRAPE_TOKEN=

# --- Redis (optional) ------------------------------------------------------

# Enables two things: a shared probe queue and a read cache.
#
# Optional on purpose. Without it the system is complete — probes run on an
# in-process timer and reads go straight to PostgreSQL — which is correct for a
# single instance and wrong for several, because every replica would probe every
# service and multiply load on the endpoints being measured. The queue makes the
# sweep singular across the fleet.
#
# docker-compose publishes Redis on 6380, not 6379, so it cannot collide with a
# Redis you already run.
# REDIS_URL=redis://localhost:6380

# Namespace for every key, so one Redis can host several environments without
# either flushing the other's data.
REDIS_KEY_PREFIX=pulsara

# Read cache for /api/services and /api/deployments, the two endpoints that do
# real work per request. Short by design: writes invalidate immediately, so the
# TTL only bounds staleness that nothing has told us about.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=10

# Service reachability probing. The scheduler wakes every tick and checks the
# services whose own interval has elapsed.
PROBES_ENABLED=true
PROBE_SCHEDULER_TICK_MS=5000
PROBE_MAX_CONCURRENCY=10

# Hysteresis. A service is only declared unhealthy after this many consecutive
# failures and only recovers after this many consecutive successes, so a single
# transient blip does not read as an outage.
SERVICE_FAILURE_THRESHOLD=3
SERVICE_RECOVERY_THRESHOLD=2

# A service that answers but takes longer than this is reported DEGRADED. For a
# user, a request that takes seconds is closer to broken than to fine.
SERVICE_DEGRADED_LATENCY_MS=1000

# Trailing window over which uptime percentage and latency percentiles are
# computed from stored probe results.
UPTIME_WINDOW_HOURS=24

# --- Federated sign-in (optional) ------------------------------------------

# Google sign-in via Firebase. Supply all three values or none of them; a
# partial configuration is rejected at startup rather than silently disabling
# the feature. Take them from the service account JSON in the Firebase console
# under Project settings > Service accounts.
#
# FIREBASE_PRIVATE_KEY must keep its literal \n escapes on one line.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Local bootstrap (read by prisma/seed.ts only) -------------------------

# The first administrator created by `npm run db:seed`. Never used by the
# running server, and never shipped to production: a production deployment
# creates its first administrator through federated sign-in instead.
SEED_ADMIN_EMAIL=admin@pulsara.dev
SEED_ADMIN_NAME=Pulsara Administrator
SEED_ADMIN_PASSWORD=change-this-local-development-password

# Origin the web client is served from. The seed registers it as a real HTTP
# probe target, so the dashboard genuinely reports whether the client is up.
SEED_WEB_ORIGIN=http://localhost:5174

# --- GitHub Actions integration (optional) ---------------------------------

# Pick ONE credential. Configuring both is rejected at startup, because which
# one is talking to GitHub would otherwise depend on code order rather than on
# configuration. ARCHITECTURE.md argues the tradeoff; the short version is that
# an App is right for anything shared and a token is right for a laptop.

# --- Option A: a GitHub App (recommended for anything deployed) ---
#
# Create at https://github.com/settings/apps with repository permissions
# "Actions: read-only" and "Metadata: read-only", subscribed to the
# "Workflow run" and "Workflow job" events, then install it on the account
# that owns the repository.
#
# The private key is the .pem GitHub gives you once, with real newlines
# replaced by \n. Convert with:
#   node -e "console.log(JSON.stringify(require('fs').readFileSync(process.argv[1],'utf8')))" app.pem
# It prints the quoted value to paste, escapes and surrounding quotes included.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
#
# Optional. Discovered automatically when the App has exactly one installation,
# and required once it has more than one: picking arbitrarily would mirror the
# wrong organisation's pipelines.
# GITHUB_APP_INSTALLATION_ID=

# --- Option B: a fine-grained personal access token (fine for development) ---
#
# Needs "Actions: read-only" and "Metadata: read-only" on the repositories being
# mirrored. Without either credential the pipelines view reports "not connected"
# rather than showing fabricated rows.
# GITHUB_TOKEN=

# Repository mirrored automatically at startup, as owner/name. It is registered
# and backfilled on boot, so a fresh deployment shows real pipelines instead of
# an empty page. Additional repositories can still be connected through the API.
#
# Change this in a fork — otherwise it mirrors this project's own repository.
GITHUB_MONITORED_REPO=Arman-op/Pulsara

# Shared secret configured on the webhook in GitHub. Required to accept
# deliveries: an unauthenticated webhook endpoint lets anyone on the internet
# write deployment records. Generate with: openssl rand -base64 32
# GITHUB_WEBHOOK_SECRET=

# Override only for GitHub Enterprise Server.
GITHUB_API_URL=https://api.github.com

# The reconciling poll. Webhooks make the data fresh; polling makes it correct
# by recovering deliveries missed while the service was restarting.
GITHUB_SYNC_ENABLED=true
GITHUB_SYNC_INTERVAL_MS=300000
GITHUB_BACKFILL_RUNS=30

# Opens an incident when the default branch's workflow is failing, and resolves
# it when the workflow passes again. Only the default branch alerts: a failing
# build on a feature branch is a developer mid-work, and opening an incident for
# every red pull-request run would bury the outages the feed exists to surface.
# After this many consecutive failed runs the incident escalates to CRITICAL.
DEPLOYMENT_ALERTS_ENABLED=true
DEPLOYMENT_FAILURE_ESCALATION_RUNS=3
