# ---------------------------------------------------------------------------
# Pulsara API environment
#
# Copy to `.env` and fill in every value. The server validates this file at
# startup (see src/config/env.ts) and refuses to boot on anything missing or
# malformed, so a misconfigured deployment fails immediately and loudly rather
# than at the first request.
#
# Nothing in this file is a real secret. In production these values are
# supplied by AWS Secrets Manager / GitHub Actions secrets and are never
# written to disk.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# One of: development | test | production.
# Controls error verbosity, cookie `secure` flag and log formatting.
NODE_ENV=development

# TCP port the HTTP + WebSocket server binds to.
PORT=4000

# Log verbosity: fatal | error | warn | info | debug | trace.
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------

# PostgreSQL connection string used by Prisma. Must start with `postgres`.
# The local development database is defined in docker-compose.yml.
DATABASE_URL=postgresql://pulsara:pulsara_local_dev@localhost:5433/pulsara?schema=public

# Database the integration tests run against. Optional: the suite falls back to
# a `pulsara_test` database on the same local instance and creates it if it is
# missing. The name must end in `_test`, because the suite truncates every table
# between cases and refuses to do that to a database that is not clearly one.
# TEST_DATABASE_URL=postgresql://pulsara:pulsara_local_dev@localhost:5433/pulsara_test

# --- HTTP ------------------------------------------------------------------

# Comma-separated list of browser origins allowed by CORS and by the
# Socket.IO handshake. No wildcard is accepted: credentials are sent with
# every request, and `Access-Control-Allow-Origin: *` is invalid with them.
CORS_ORIGINS=http://localhost:5174

# Fixed-window rate limit applied to the whole /api surface.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# --- Authentication --------------------------------------------------------

# HMAC signing keys. Minimum 32 characters, and must differ from each other so
# that an access token can never be replayed as a refresh token.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48-output-value
JWT_REFRESH_SECRET=replace-me-with-a-different-openssl-rand-base64-48-value

# Access tokens are short-lived because they are held in browser memory and
# cannot be revoked; the refresh token is the revocable half of the pair.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Credential endpoints (/auth/login, /auth/firebase) get a far tighter budget
# than the rest of the API. Only failed attempts count toward it.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# --- Telemetry -------------------------------------------------------------

# Label applied to every host metric this process records. Defaults to the
# machine's hostname, which is what keeps samples from several replicas
# distinguishable once the API is scaled out.
# TELEMETRY_HOST_ID=

# Host metric collection. Each tick reads real OS counters (CPU, memory, disk,
# network, load), writes one row per family and broadcasts to connected
# clients, so the interval trades chart resolution against write volume.
METRICS_COLLECTION_ENABLED=true
METRICS_COLLECTION_INTERVAL_MS=5000

# Retention. Telemetry is append-only and grows without bound; the sweep runs
# in bounded batches so it never blocks the collector writing the same table.
# Probe results are kept longer because they are the evidence behind uptime
# figures and incident timelines.
METRICS_RETENTION_DAYS=7
PROBE_RESULT_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_MS=3600000

# Service reachability probing. The scheduler wakes every tick and checks the
# services whose own interval has elapsed.
PROBES_ENABLED=true
PROBE_SCHEDULER_TICK_MS=5000
PROBE_MAX_CONCURRENCY=10

# Hysteresis. A service is only declared unhealthy after this many consecutive
# failures and only recovers after this many consecutive successes, so a single
# transient blip does not read as an outage.
SERVICE_FAILURE_THRESHOLD=3
SERVICE_RECOVERY_THRESHOLD=2

# A service that answers but takes longer than this is reported DEGRADED. For a
# user, a request that takes seconds is closer to broken than to fine.
SERVICE_DEGRADED_LATENCY_MS=1000

# Trailing window over which uptime percentage and latency percentiles are
# computed from stored probe results.
UPTIME_WINDOW_HOURS=24

# --- Federated sign-in (optional) ------------------------------------------

# Google sign-in via Firebase. Supply all three values or none of them; a
# partial configuration is rejected at startup rather than silently disabling
# the feature. Take them from the service account JSON in the Firebase console
# under Project settings > Service accounts.
#
# FIREBASE_PRIVATE_KEY must keep its literal \n escapes on one line.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Local bootstrap (read by prisma/seed.ts only) -------------------------

# The first administrator created by `npm run db:seed`. Never used by the
# running server, and never shipped to production: a production deployment
# creates its first administrator through federated sign-in instead.
SEED_ADMIN_EMAIL=admin@pulsara.dev
SEED_ADMIN_NAME=Pulsara Administrator
SEED_ADMIN_PASSWORD=change-this-local-development-password

# Origin the web client is served from. The seed registers it as a real HTTP
# probe target, so the dashboard genuinely reports whether the client is up.
SEED_WEB_ORIGIN=http://localhost:5174

# --- GitHub Actions integration (optional) ---------------------------------

# Token with `actions:read` on the repositories being mirrored (a fine-grained
# PAT or a GitHub App installation token). Without it the pipelines view
# reports "not connected" rather than showing fabricated rows.
# GITHUB_TOKEN=

# Shared secret configured on the webhook in GitHub. Required to accept
# deliveries: an unauthenticated webhook endpoint lets anyone on the internet
# write deployment records. Generate with: openssl rand -base64 32
# GITHUB_WEBHOOK_SECRET=

# Override only for GitHub Enterprise Server.
GITHUB_API_URL=https://api.github.com

# The reconciling poll. Webhooks make the data fresh; polling makes it correct
# by recovering deliveries missed while the service was restarting.
GITHUB_SYNC_ENABLED=true
GITHUB_SYNC_INTERVAL_MS=300000
GITHUB_BACKFILL_RUNS=30
